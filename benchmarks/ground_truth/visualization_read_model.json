{
  "read_model": {
    "required_node_kinds": [
      "component",
      "database"
    ],
    "required_edge_kinds": [
      "CONTAINS"
    ],
    "require_hypotheses": true,
    "require_all_edges_valid": true,
    "require_traceability": true,
    "require_determinism": true,
    "svg": {
      "require_valid": true,
      "require_all_elements": true,
      "require_determinism": true,
      "require_inspection_metadata": true,
      "required_relation_classes": [
        "architectural",
        "structural"
      ],
      "required_layout_groups": [
        "domain",
        "persistence",
        "external"
      ]
    },
    "animation": {
      "require_static_valid": true,
      "require_animated_valid": true,
      "require_static_deterministic": true,
      "require_animated_deterministic": true,
      "require_semantics_preserved": true,
      "require_read_model_unchanged": true
    },
    "web": {
      "require_static_available": true,
      "require_animated_available": true,
      "require_accessibility_metadata": true,
      "require_deterministic_output": true
